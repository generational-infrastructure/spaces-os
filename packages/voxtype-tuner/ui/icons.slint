// Spaces icon set. One stroke contract for the whole kit: a single 1.5px
// stroke on a 24-unit grid, no fill, tinted (currentColor-style) through
// `tint`. Every glyph is expressed as an SVG `commands` string in viewbox
// units, so one Path renders any glyph and there is no external runtime asset.
// A semantic (green) tint is only for on-state icons. Everything else stays
// on a neutral text token.
//
// Kept Slint 1.16-compatible (see theme.slint header).

import { Theme } from "theme.slint";

export component Icon inherits Path {
    in property <length> size: 24px;
    in property <color> tint: Theme.text-secondary;
    // Fill the glyph interior instead of stroking it (the play triangle and the
    // record stop square read as solid marks, not outlines). Off by default so
    // every other glyph stays the single-stroke contract.
    in property <bool> filled: false;
    // "mic" | "play" | "pause" | "stop" | "record" | "copy" | "chevron-down"
    // | "check" | "close" | "download" | "arrow-right" | "info" | "bars"
    // | "broadcast"
    in property <string> glyph: "check";

    width: root.size;
    height: root.size;

    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;

    stroke: root.tint;
    stroke-width: 1.5px;
    stroke-line-cap: round;
    fill: root.filled ? root.tint : transparent;

    commands: root.glyph == "check" ? "M 5 12.5 L 10 17.5 L 19 6.5"
        : root.glyph == "close" ? "M 6 6 L 18 18 M 18 6 L 6 18"
        : root.glyph == "chevron-down" ? "M 6 9.5 L 12 15.5 L 18 9.5"
        : root.glyph == "arrow-right" ? "M 4 12 L 20 12 M 14 6 L 20 12 L 14 18"
        : root.glyph == "play" ? "M 8 5.5 L 19 12 L 8 18.5 Z"
        // Pause: two open vertical strokes, matched to the play triangle's
        // height so the take-play button swaps Play↔Pause in place without a
        // footprint shift.
        : root.glyph == "pause" ? "M 9.5 6 L 9.5 18 M 14.5 6 L 14.5 18"
        : root.glyph == "stop" ? "M 7.5 7.5 L 16.5 7.5 L 16.5 16.5 L 7.5 16.5 Z"
        : root.glyph == "record" ? "M 7 12 A 5 5 0 1 1 17 12 A 5 5 0 1 1 7 12 Z"
        : root.glyph == "download" ? "M 12 3 L 12 14 M 8 10 L 12 14 L 16 10 M 5 16 L 5 20 L 19 20 L 19 16"
        : root.glyph == "copy" ? "M 8.5 8.5 L 8.5 4 L 20 4 L 20 15.5 L 15.5 15.5 M 4 8.5 L 15.5 8.5 L 15.5 20 L 4 20 Z"
        : root.glyph == "info" ? "M 3 12 A 9 9 0 1 1 21 12 A 9 9 0 1 1 3 12 Z M 12 11 L 12 16.5 M 12 7.5 L 12 8"
        : root.glyph == "mic" ? "M 9 6 A 3 3 0 0 1 15 6 L 15 12 A 3 3 0 0 1 9 12 Z M 7 13 A 5 5 0 0 0 17 13 M 12 18 L 12 21 M 8.5 21 L 15.5 21"
        // Audio bars: five vertical strokes, tall at the centre, tapering to a
        // short cap on each edge. The Transcribe pill's leading mark.
        : root.glyph == "bars" ? "M 4 11 L 4 13 M 8 8 L 8 16 M 12 5 L 12 19 M 16 8 L 16 16 M 20 11 L 20 13"
        // Broadcast: a centre node with radiating arcs on each side, the live
        // Stream action's mark.
        : root.glyph == "broadcast" ? "M 11 12 A 1 1 0 1 1 13 12 A 1 1 0 1 1 11 12 Z M 8.5 9 A 4.5 4.5 0 0 0 8.5 15 M 15.5 9 A 4.5 4.5 0 0 1 15.5 15 M 6 6.5 A 8.5 8.5 0 0 0 6 17.5 M 18 6.5 A 8.5 8.5 0 0 1 18 17.5"
        // Trash can: the Clear link's mark (lid, bin body, two tines).
        : root.glyph == "trash" ? "M 5 7 L 19 7 M 9.5 7 L 9.5 5 L 14.5 5 L 14.5 7 M 6.5 7 L 7.5 19.5 L 16.5 19.5 L 17.5 7 M 10.5 10 L 10.5 16.5 M 13.5 10 L 13.5 16.5"
        : "";
}
