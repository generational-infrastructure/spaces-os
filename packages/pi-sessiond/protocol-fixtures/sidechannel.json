{
  "description": "Side channel round-trip (design §6): the child's extension_ui_request surfaces as a buffered event; a client answers via command{extension_ui_response}; every OTHER attached client gets sidechannel_resolved naming the winner, and a lost-race answer gets by:\"\" back. Integration approvals ride the same rails with approval_response.",
  "v": 1,
  "frames": [
    {
      "dir": "server",
      "envelope": {
        "v": 1,
        "kind": "event",
        "sessionId": "s1",
        "seq": 9,
        "payload": { "type": "extension_ui_request", "id": "sc-1", "method": "confirm", "title": "Run it?" }
      }
    },
    {
      "dir": "client",
      "envelope": {
        "v": 1,
        "kind": "command",
        "sessionId": "s1",
        "payload": { "type": "extension_ui_response", "id": "sc-1", "confirmed": true }
      }
    },
    {
      "dir": "server",
      "envelope": { "v": 1, "kind": "sidechannel_resolved", "sessionId": "s1", "id": "sc-1", "by": "c1" }
    },
    {
      "dir": "server",
      "envelope": { "v": 1, "kind": "sidechannel_resolved", "sessionId": "s1", "id": "sc-1", "by": "" }
    },
    {
      "dir": "client",
      "envelope": {
        "v": 1,
        "kind": "command",
        "sessionId": "s1",
        "payload": { "type": "approval_response", "id": "appr-1", "decision": "once" }
      }
    }
  ]
}
