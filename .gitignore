# direnv
.direnv/

# nix
result
result-*


# qemu disk images
*.qcow2

# repo-local secrets — see .env.example
.env

# node
node_modules/
dist/

# python
__pycache__/
# grpcio-tools output regenerated at build/test time from bridge.proto
packages/integration-proton/bridge_pb2*.py

# sediment writes a project-id config wherever its CLI is invoked
# from inside a git/jj repo (see get_or_create_project_id). Ignore it
# so debugging memory state from this checkout doesn't dirty the tree.
.sediment/

# agent-vm workdir (qcow2 + serial log; sockets live under /tmp)
.agent-vm/

# remote-agent-vm workdir (server/client qcow2 + serial logs; sockets under /tmp)
.remote-agent-vm/

# legacy swtpm runtime state (now under ~/.local/state/agent-vm; kept for
# old checkouts)
test-machine-swtpm/
